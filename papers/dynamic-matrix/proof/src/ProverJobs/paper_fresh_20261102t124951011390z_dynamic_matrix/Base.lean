/-! ### Norm and inner-product conventions of the source

`‖M‖₀ = rank M`, `‖M‖₁ =` nuclear norm (sum of singular values),
`‖M‖₂ =` Frobenius norm, `‖M‖∞ =` maximum singular value (operator norm),
and `⟨M, N⟩ = Tr(Mᵀ N)` is the Frobenius trace inner product. -/

/-- The Frobenius norm `‖M‖₂ = sqrt (∑_{i,j} M_{ij}^2)` of a real matrix. -/
noncomputable def frobNorm {m1 m2 : ℕ} (M : Matrix (Fin m1) (Fin m2) ℝ) : ℝ :=
  Real.sqrt (∑ i : Fin m1, ∑ j : Fin m2, M i j ^ 2)

/-- The Frobenius trace inner product `⟨M, X⟩ = Tr(Mᵀ X) = ∑_{i,j} M_{ij} X_{ij}`. -/
noncomputable def frobInner {m1 m2 : ℕ} (M X : Matrix (Fin m1) (Fin m2) ℝ) : ℝ :=
  ∑ i : Fin m1, ∑ j : Fin m2, M i j * X i j

/-- The vectorization `vec(M) ∈ ℝ^{m₁m₂}` of a matrix `M ∈ ℝ^{m₁×m₂}`. -/
def vecOf {m1 m2 : ℕ} (M : Matrix (Fin m1) (Fin m2) ℝ) : Fin m1 × Fin m2 → ℝ :=
  fun a => M a.1 a.2

/-- The design second moment quadratic form `q(M) = vec(M)ᵀ Σ vec(M)`. -/
noncomputable def secondMomentForm {m1 m2 : ℕ}
    (Sigma : Matrix (Fin m1 × Fin m2) (Fin m1 × Fin m2) ℝ)
    (M : Matrix (Fin m1) (Fin m2) ℝ) : ℝ :=
  ∑ a : Fin m1 × Fin m2, ∑ b : Fin m1 × Fin m2, vecOf M a * Sigma a b * vecOf M b

/-- `λ_min`: the smallest eigenvalue of a Hermitian matrix (the infimum of its eigenvalues). -/
noncomputable def lamMin {ι : Type*} (ev : ι → ℝ) : ℝ := ⨅ i, ev i

/-- `λ_max`: the largest eigenvalue of a Hermitian matrix (the supremum of its eigenvalues). -/
noncomputable def lamMax {ι : Type*} (ev : ι → ℝ) : ℝ := ⨆ i, ev i

variable {Ω : Type*} [MeasurableSpace Ω]

/-- `Δ_j = (1/n_j) ∑_{i=1}^{n_j} (Y_{ji} X_{ji} - E[Y_{ji} X_{ji}])`, entrywise, where the
expectation is with respect to the probability measure `P`. -/
noncomputable def DeltaMat {m1 m2 T : ℕ} (P : Measure Ω) (n : Fin T → ℕ)
    (Y : (j : Fin T) → Fin (n j) → Ω → ℝ)
    (X : (j : Fin T) → Fin (n j) → Ω → Matrix (Fin m1) (Fin m2) ℝ)
    (j : Fin T) (ω : Ω) : Matrix (Fin m1) (Fin m2) ℝ :=
  fun a b =>
    (1 / (n j : ℝ)) *
      ∑ i : Fin (n j),
        (Y j i ω * (X j i ω) a b - ∫ ω', Y j i ω' * (X j i ω') a b ∂P)

/-- `𝒲_hΔ_t = ‖∑_j ω_h(j-t) Δ_j‖_∞`, the maximum singular value (operator norm) of the
weighted empirical cross-moment deviation. -/
noncomputable def WDelta {m1 m2 T : ℕ} (P : Measure Ω) (n : Fin T → ℕ)
    (Y : (j : Fin T) → Fin (n j) → Ω → ℝ)
    (X : (j : Fin T) → Fin (n j) → Ω → Matrix (Fin m1) (Fin m2) ℝ)
    (w : Fin T → ℝ) (ω : Ω) : ℝ :=
  Statlib.HighDim.MatrixAnalysis.opNorm (∑ j : Fin T, w j • DeltaMat P n Y X j ω)

/-- `δ_h M_t = ‖M_t^0 - ∑_j ω_h(j-t) M_j^0‖₂` (smoothing bias, Frobenius norm). -/
noncomputable def biasH {m1 m2 T : ℕ} (M0 : Fin T → Matrix (Fin m1) (Fin m2) ℝ)
    (w : Fin T → ℝ) (t : Fin T) : ℝ :=
  frobNorm (M0 t - ∑ j : Fin T, w j • M0 j)

/-- The objective of the local nuclear-norm penalized estimator (eq_local_estimator):
`∑_j ω_h(j-t) [ vec(M)ᵀ Σ vec(M) - 2 ⟨(1/n_j)∑_i Y_{ji}X_{ji}, M⟩ ] + λ ‖M‖₁`,
where the first term is the design second moment `E(⟨M, X_{ji}⟩)²` and `‖M‖₁` is the nuclear
norm. -/
noncomputable def localObj {m1 m2 T : ℕ}
    (Sigma : Matrix (Fin m1 × Fin m2) (Fin m1 × Fin m2) ℝ)
    (P : Measure Ω) (n : Fin T → ℕ)
    (Y : (j : Fin T) → Fin (n j) → Ω → ℝ)
    (X : (j : Fin T) → Fin (n j) → Ω → Matrix (Fin m1) (Fin m2) ℝ)
    (w : Fin T → ℝ) (lam : ℝ) (M : Matrix (Fin m1) (Fin m2) ℝ) (ω : Ω) : ℝ :=
  ∑ j : Fin T, w j *
    (secondMomentForm Sigma M -
      2 * frobInner ((1 / (n j : ℝ)) • ∑ i : Fin (n j), Y j i ω • X j i ω) M)
    + lam * Statlib.HighDim.Vocabulary.nuclearNorm M

