/-- Squared Hilbert-scale norm `‖u‖²_{U^t} = ‖𝒞₀^{-t/2} u‖²_𝒰` of the prior covariance, computed
from the spectral decomposition `𝒞₀ = ∑_k λ_k e_k ⊗ e_k` as `∑_k λ_k^{-t} ⟪e_k,u⟫²` (Subsection
3.1 of the source: `⟨u,v⟩_{U^t} = ⟨𝒞₀^{-t/2}u, 𝒞₀^{-t/2}v⟩_𝒰`). It is valued in `ℝ≥0∞` (so it is
`⊤` off the scale space instead of Mathlib's junk `0` for a divergent `tsum`); the source norm
`‖u‖_{U^t}` is its square root (`UScaleDist`) — see `UScaleDist`. -/
def UScaleNorm {U : Type*} [NormedAddCommGroup U] [InnerProductSpace ℝ U]
    (e : HilbertBasis ℕ ℝ U) (lam : ℕ → ℝ) (t : ℝ) (u : U) : ℝ≥0∞ :=
  ∑' k : ℕ, ENNReal.ofReal (Real.rpow (lam k) (-t) * (inner ℝ (e k) u) ^ 2)

/-- The Hilbert scale space `U^t` of `𝒰`: the elements on which the scale norm is finite, i.e.
`𝒞₀^{-t/2} u ∈ 𝒰` (equivalently `∑_k λ_k^{-t} ⟪e_k,u⟫² < ∞`). -/
def UScale {U : Type*} [NormedAddCommGroup U] [InnerProductSpace ℝ U]
    (e : HilbertBasis ℕ ℝ U) (lam : ℕ → ℝ) (t : ℝ) : Set U :=
  {u : U | UScaleNorm e lam t u < ⊤}

/-- Squared Hilbert-scale norm `‖v‖²_{H^t} = ‖𝒞₁^{-t/2} v‖²_ℋ` of the operator `𝒞₁`, computed
from its eigensystem `{μ_i, bH_i}` as `∑_i μ_i^{-t} ⟪bH_i,v⟫²`, valued in `ℝ≥0∞` (so it is `⊤`
off the scale space instead of Mathlib's junk `0` for a divergent `tsum`). The source norm is its
square root — see `HScaleDist`. -/
def HScaleNorm {H ι : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (bH : HilbertBasis ι ℝ H) (mu : ι → ℝ) (t : ℝ) (v : H) : ℝ≥0∞ :=
  ∑' i : ι, ENNReal.ofReal (Real.rpow (mu i) (-t) * (inner ℝ (bH i) v) ^ 2)

/-- The Hilbert scale space `H^t` of `ℋ` for the operator `𝒞₁`: the elements on which the scale
norm is finite, i.e. `𝒞₁^{-t/2} v ∈ ℋ`. -/
def HScale {H ι : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (bH : HilbertBasis ι ℝ H) (mu : ι → ℝ) (t : ℝ) : Set H :=
  {v : H | HScaleNorm bH mu t v < ⊤}

/-- The source scale-norm difference `‖v' - v‖_{H^t}` (an extended nonnegative quantity, `⊤` when
`v' - v ∉ H^t`): the square root of `HScaleNorm bH mu t (v' - v)`. -/
def HScaleDist {H ι : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (bH : HilbertBasis ι ℝ H) (mu : ι → ℝ) (t : ℝ) (v' v : H) : ℝ≥0∞ :=
  (HScaleNorm bH mu t (v' - v)) ^ (1 / 2 : ℝ)

/-- The source scale-norm difference `‖u' - u‖_{U^t}`: the square root of
`UScaleNorm e lam t (u' - u)`. -/
def UScaleDist {U : Type*} [NormedAddCommGroup U] [InnerProductSpace ℝ U]
    (e : HilbertBasis ℕ ℝ U) (lam : ℕ → ℝ) (t : ℝ) (u' u : U) : ℝ≥0∞ :=
  (UScaleNorm e lam t (u' - u)) ^ (1 / 2 : ℝ)

/-- The exponential-moment integrand `exp(δ M₁(‖u‖_{U^{1-ṡ}})²)` of the theorem's `δ₀` condition,
where `r = ‖u‖_{U^{1-ṡ}}` is the (extended) Hilbert-scale norm of `u`. It is `⊤` when
`u ∉ U^{1-ṡ}` (i.e. `r = ⊤`), so a finite integral forces `P^θ_S` to concentrate on `U^{1-ṡ}`. -/
def momentExpENN (M1 : ℝ → ℝ) (δ : ℝ) (r : ℝ≥0∞) : ℝ≥0∞ :=
  if h : r < ⊤ then ENNReal.ofReal (Real.exp (δ * (M1 r.toReal) ^ 2)) else ⊤

/-- Eigenvalues of the learned-prior covariance (4): `e^{θ_{2k}}` on the first `N_c`
coordinates and `λ_k` afterwards. -/
def priorEigen (lam : ℕ → ℝ) (Nc : ℕ) (θ2 : Fin Nc → ℝ) (k : ℕ) : ℝ :=
  if h : k < Nc then Real.exp (θ2 ⟨k, h⟩) else lam k

/-- The source's potential
`Φ(u; x, y) = ½‖Γ^{-1/2} L_x G(u)‖² - ⟪Γ^{-1/2} y, Γ^{-1/2} L_x G(u)⟫`, built from the linear
`Γ^{-1/2}` (here `Γih`). -/
def Phi {U H X : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (Γih : H → H) (LG : X → U → H) (u : U) (x : X) (y : H) : ℝ :=
  (1 / 2 : ℝ) * ‖Γih (LG x u)‖ ^ 2 - inner ℝ (Γih y) (Γih (LG x u))

/-- The dataset potential `∑_{j} Φ(u; x_j, y_j)`. -/
def potSum {U H X ι : Type*} [Fintype ι] [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (Γih : H → H) (LG : X → U → H) (S : ι → X × H) (u : U) : ℝ :=
  ∑ j : ι, Phi Γih LG u (S j).1 (S j).2

/-- The unnormalized tempered posterior density `exp(-(β/m) ∑_j Φ(u; x_j, y_j))`. -/
def temperedDens {U H X ι : Type*} [Fintype ι] [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (β : ℝ) (m : ℕ) (Γih : H → H) (LG : X → U → H) (S : ι → X × H) (u : U) : ℝ :=
  Real.exp (-(β / (m : ℝ)) * potSum Γih LG S u)

/-- The normalizing constant `Z_m` of (6). -/
def Zm {U H X ι : Type*} [Fintype ι] [MeasurableSpace U]
    [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (β : ℝ) (m : ℕ) (Γih : H → H) (LG : X → U → H) (P : Measure U)
    (S : ι → X × H) : ℝ :=
  ∫ u, temperedDens β m Γih LG S u ∂P

/-- The generalized Bayesian posterior `Q(S, P^θ_S)` of (6): the learned prior tilted by the
tempered likelihood and normalized. Normalization uses the extended (lower) integral of the
nonnegative density, so this is the source's normalized generalized posterior for *every* dataset
`S`; the real-valued normalizer `Z_m` of (6) is that normalizing constant whenever the density is
integrable (assertion (i) of the conclusion), so no junk value of a real Bochner integral occurs. -/
def Qpost {U H X ι : Type*} [Fintype ι] [MeasurableSpace U]
    [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (β : ℝ) (m : ℕ) (Γih : H → H) (LG : X → U → H) (P : Measure U)
    (S : ι → X × H) : Measure U :=
  P.withDensity
    (fun u => ENNReal.ofReal (temperedDens β m Γih LG S u) /
      (∫⁻ v, ENNReal.ofReal (temperedDens β m Γih LG S v) ∂P))

/-- The Hellinger metric `d_Hell(P, Q) = (½ ∫ (√(dP/dρ) - √(dQ/dρ))² dρ)^{1/2}`
with the common reference measure `ρ = P + Q`. -/
def hellingerDist {E : Type*} [MeasurableSpace E] (μ ν : Measure E) : ℝ :=
  Real.sqrt ((1 / 2 : ℝ) *
    (∫⁻ x, ENNReal.ofReal ((Real.sqrt (μ.rnDeriv (μ + ν) x).toReal -
      Real.sqrt (ν.rnDeriv (μ + ν) x).toReal) ^ 2) ∂(μ + ν)).toReal)

/-- Neighbourhood filter of `y` for the Hilbert-scale norm `‖·‖_{H^t}` (valued in `ℝ≥0∞`),
restricted to the scale subspace `ok` (`= H^t`): the filter generated by the sets
`{y' | ok y' ∧ ‖y' - y‖_{H^t} < ε}`. In Mathlib's convention
`l.HasBasis p s ↔ l = ⨅ i, ⨅ (_ : p i), 𝓟 (s i)` (cf. `nhds_basis_ball`), so this is `⨅`. -/
def scaleNhds {E : Type*} [NormedAddCommGroup E] (nrm : E → ℝ≥0∞) (ok : E → Prop) (y : E) :
    Filter E :=
  ⨅ ε : { ε : ℝ // 0 < ε },
    Filter.principal { y' : E | ok y' ∧ nrm (y' - y) < ENNReal.ofReal ε }

/-- The data neighbourhood filter at `S`: `x_j → x_j'` in `𝒳` and `y_j → y_j'` in the Hilbert-scale
space `H^{α-s}` (norm `nrm`, membership `ok`). -/
def dataNhds {X H ι : Type*} [TopologicalSpace X] [NormedAddCommGroup H]
    (nrm : H → ℝ≥0∞) (ok : H → Prop) (S : ι → X × H) : Filter (ι → X × H) :=
  ⨅ j : ι, Filter.comap (fun S' => (S' j).1) (𝓝 (S j).1) ⊓
    Filter.comap (fun S' => (S' j).2) (scaleNhds nrm ok (S j).2)

