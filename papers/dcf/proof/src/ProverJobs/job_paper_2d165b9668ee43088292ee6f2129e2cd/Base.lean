point intervals are included (the condition `a j ≤ b j` excludes empty ones). -/
def IsHyperrect {p : ℕ} (A : Set (Fin p → ℝ)) : Prop :=
  ∃ a b : Fin p → EReal, (∀ j, a j ≤ b j) ∧
    A = {w | ∀ j, a j ≤ (w j : EReal) ∧ (w j : EReal) ≤ b j}

