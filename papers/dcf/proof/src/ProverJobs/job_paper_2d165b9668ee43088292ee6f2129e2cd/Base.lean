/-- Coordinatewise maximum `max_{1 ≤ j ≤ p} f j` (for `p ≥ 1`), written as the
supremum of the finite range. -/
noncomputable def coordMax {p : ℕ} (f : Fin p → ℝ) : ℝ := sSup (Set.range f)

