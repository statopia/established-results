/-- The class `𝒜^Re` of hyperrectangles in `ℝ^p` of the form
`{w : a_j ≤ w_j ≤ b_j for all j}`, with endpoints in `[-∞, ∞]`. -/
def IsHyperrectangle {p : ℕ} (A : Set (Fin p → ℝ)) : Prop :=
  ∃ a b : Fin p → EReal,
    (∀ j, a j ≤ b j) ∧
      A = {w : Fin p → ℝ | ∀ j, a j ≤ ((w j : ℝ) : EReal) ∧ ((w j : ℝ) : EReal) ≤ b j}

/-- The normalized sum `S_N^Z = N^{-1/2} ∑_{i=1}^N Z_i`, coordinatewise. -/
noncomputable def normalizedSum {Ω : Type*} {p : ℕ} (N : ℕ)
    (Z : Fin N → Ω → Fin p → ℝ) (ω : Ω) : Fin p → ℝ :=
  fun j => (1 / Real.sqrt (N : ℝ)) * ∑ i : Fin N, Z i ω j

/-- The combined vector `S_n^X - n^{1/2} μ^X + δ_{n,m} S_m^Y - δ_{n,m} m^{1/2} μ^Y`. -/
noncomputable def combinedStat {Ω : Type*} {p : ℕ} (n m : ℕ) (δ : ℝ)
    (μX μY : Fin p → ℝ) (X : Fin n → Ω → Fin p → ℝ) (Y : Fin m → Ω → Fin p → ℝ)
    (ω : Ω) : Fin p → ℝ :=
  fun j =>
    normalizedSum n X ω j - Real.sqrt (n : ℝ) * μX j + δ * normalizedSum m Y ω j
      - δ * (Real.sqrt (m : ℝ) * μY j)

/-- `ρ_{n,m}^{**}`: the supremum over all hyperrectangles of the difference between the law
of the combined `X,Y` vector and the law of the combined Gaussian `F,G` vector. -/
noncomputable def rhoStarStar {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) {p : ℕ}
    (Z₁ Z₂ : Ω → Fin p → ℝ) : ℝ :=
  sSup {t : ℝ | ∃ A : Set (Fin p → ℝ), IsHyperrectangle A ∧
    t = |(P.map Z₁ A).toReal - (P.map Z₂ A).toReal|}

/-- `L_N^Z = max_{1 ≤ j ≤ p} N^{-1} ∑_{i=1}^N E |Z_{ij} - μ_j|^3`. -/
noncomputable def LThird {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) {p N : ℕ}
    (Z : Fin N → Ω → Fin p → ℝ) (μ : Fin p → ℝ) : ℝ :=
  ⨆ j : Fin p, (1 / (N : ℝ)) * ∑ i : Fin N, ∫ ω, |Z i ω j - μ j| ^ 3 ∂P

/-- The joint family of all `2n + 2m` random vectors, indexed by
`Fin n ⊕ (Fin m ⊕ (Fin n ⊕ Fin m))`; joint independence of this family encodes the
independence within each collection and between the four collections. -/
def jointFamily {Ω : Type*} {p n m : ℕ}
    (X : Fin n → Ω → Fin p → ℝ) (Y : Fin m → Ω → Fin p → ℝ)
    (F : Fin n → Ω → Fin p → ℝ) (G : Fin m → Ω → Fin p → ℝ) :
    (Fin n ⊕ (Fin m ⊕ (Fin n ⊕ Fin m))) → Ω → (Fin p → ℝ)
  | Sum.inl i, ω => X i ω
  | Sum.inr (Sum.inl i), ω => Y i ω
  | Sum.inr (Sum.inr (Sum.inl i)), ω => F i ω
  | Sum.inr (Sum.inr (Sum.inr i)), ω => G i ω

