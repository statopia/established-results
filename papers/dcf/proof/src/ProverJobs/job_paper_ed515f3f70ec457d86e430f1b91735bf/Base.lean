/-- Coordinatewise maximum of the absolute values of the coordinates of `x`. -/
def maxAbs {p : ℕ} (x : Fin p → ℝ) : ℝ := ⨆ j : Fin p, |x j|

/-- The normalized sum `S_n^Z = n^{-1/2} ∑_{i=1}^n Z_i`, coordinatewise. -/
def normSum {p : ℕ} (n : ℕ) (Z : Fin n → Fin p → ℝ) : Fin p → ℝ :=
  fun j => (Real.sqrt (n : ℝ))⁻¹ * ∑ i : Fin n, Z i j

/-- The centered combined vector `S_n^X - √n μ^X + δ S_m^Y - δ √m μ^Y`. -/
def combVec {p : ℕ} (n m : ℕ) (delta : ℝ) (muX muY : Fin p → ℝ)
    (X : Fin n → Fin p → ℝ) (Y : Fin m → Fin p → ℝ) : Fin p → ℝ :=
  fun j =>
    normSum n X j - Real.sqrt (n : ℝ) * muX j + delta * normSum m Y j -
      delta * Real.sqrt (m : ℝ) * muY j

/-- `ρ_{n,m}`: the supremum over `v ∈ [0,1]` and `y ∈ ℝ^p` of the absolute
difference of the lower-left orthant probabilities of the `v`-mixture of the
data term and the Gaussian term, and of the Gaussian term alone. -/
def rho {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) (n m p : ℕ) (delta : ℝ)
    (muX muY : Fin p → ℝ)
    (X : Fin n → Ω → Fin p → ℝ) (Y : Fin m → Ω → Fin p → ℝ)
    (F : Fin n → Ω → Fin p → ℝ) (G : Fin m → Ω → Fin p → ℝ) : ℝ :=
  ⨆ v : Set.Icc (0 : ℝ) 1, ⨆ y : Fin p → ℝ,
    |(P {ω | ∀ j : Fin p,
            Real.sqrt (v : ℝ) * combVec n m delta muX muY (fun i => X i ω) (fun i => Y i ω) j
          + Real.sqrt (1 - (v : ℝ)) *
              combVec n m delta muX muY (fun i => F i ω) (fun i => G i ω) j ≤ y j}).toReal
      - (P {ω | ∀ j : Fin p,
            combVec n m delta muX muY (fun i => F i ω) (fun i => G i ω) j ≤ y j}).toReal|

/-- `L_n^X = max_j n^{-1} ∑_i E|X_{ij} - μ^X_j|^3`. -/
def LX {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) {p : ℕ} (n : ℕ)
    (muX : Fin p → ℝ) (X : Fin n → Ω → Fin p → ℝ) : ℝ :=
  ⨆ j : Fin p, (n : ℝ)⁻¹ * ∑ i : Fin n, ∫ ω, |X i ω j - muX j| ^ 3 ∂P

/-- `L_m^Y = max_j m^{-1} ∑_i E|Y_{ij} - μ^Y_j|^3`. -/
def LY {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) {p : ℕ} (m : ℕ)
    (muY : Fin p → ℝ) (Y : Fin m → Ω → Fin p → ℝ) : ℝ :=
  ⨆ j : Fin p, (m : ℝ)⁻¹ * ∑ i : Fin m, ∫ ω, |Y i ω j - muY j| ^ 3 ∂P

/-- `M_n^X(φ)`: truncated third moment of `max_j |X_{ij} - μ^X_j|^3`. -/
def MX {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) {p : ℕ} (n : ℕ)
    (muX : Fin p → ℝ) (X : Fin n → Ω → Fin p → ℝ) (phi : ℝ) : ℝ :=
  (n : ℝ)⁻¹ * ∑ i : Fin n,
    ∫ ω, Set.indicator
        {ω' : Ω | maxAbs (fun j => X i ω' j - muX j) >
          Real.sqrt (n : ℝ) / (4 * phi * Real.log (p : ℝ))}
        (fun ω' => (maxAbs (fun j => X i ω' j - muX j)) ^ 3) ω ∂P

/-- `M_n^F(φ)`: truncated third moment of `max_j |F_{ij} - μ^X_j|^3`. -/
def MF {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) {p : ℕ} (n : ℕ)
    (muX : Fin p → ℝ) (F : Fin n → Ω → Fin p → ℝ) (phi : ℝ) : ℝ :=
  (n : ℝ)⁻¹ * ∑ i : Fin n,
    ∫ ω, Set.indicator
        {ω' : Ω | maxAbs (fun j => F i ω' j - muX j) >
          Real.sqrt (n : ℝ) / (4 * phi * Real.log (p : ℝ))}
        (fun ω' => (maxAbs (fun j => F i ω' j - muX j)) ^ 3) ω ∂P

/-- `M_n(φ) = M_n^X(φ) + M_n^F(φ)`. -/
def Mn {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) {p : ℕ} (n : ℕ)
    (muX : Fin p → ℝ) (X : Fin n → Ω → Fin p → ℝ) (F : Fin n → Ω → Fin p → ℝ)
    (phi : ℝ) : ℝ :=
  MX P n muX X phi + MF P n muX F phi

/-- `M_m^Y(φ)`: truncated third moment of `max_j |Y_{ij} - μ^Y_j|^3`,
with threshold `√m / (4 |δ_{n,m}| φ log p)`. At `δ_{n,m} = 0` the truncation
level `m^{1/2}/(4|δ_{n,m}|φ log p)` is `+∞`, the indicators are empty, and the
quantity is `0`; this is the encoding `if d = 0 then 0 else …`. -/
def MY {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) {p : ℕ} (m : ℕ) (d : ℝ)
    (muY : Fin p → ℝ) (Y : Fin m → Ω → Fin p → ℝ) (phi : ℝ) : ℝ :=
  if d = 0 then 0 else
    (m : ℝ)⁻¹ * ∑ i : Fin m,
      ∫ ω, Set.indicator
          {ω' : Ω | maxAbs (fun j => Y i ω' j - muY j) >
            Real.sqrt (m : ℝ) / (4 * |d| * phi * Real.log (p : ℝ))}
          (fun ω' => (maxAbs (fun j => Y i ω' j - muY j)) ^ 3) ω ∂P

/-- `M_m^G(φ)`: truncated third moment of `max_j |G_{ij} - μ^Y_j|^3`,
with threshold `√m / (4 |δ_{n,m}| φ log p)`. At `δ_{n,m} = 0` the truncation
level `m^{1/2}/(4|δ_{n,m}|φ log p)` is `+∞`, the indicators are empty, and the
quantity is `0`; this is the encoding `if d = 0 then 0 else …`. -/
def MG {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) {p : ℕ} (m : ℕ) (d : ℝ)
    (muY : Fin p → ℝ) (G : Fin m → Ω → Fin p → ℝ) (phi : ℝ) : ℝ :=
  if d = 0 then 0 else
    (m : ℝ)⁻¹ * ∑ i : Fin m,
      ∫ ω, Set.indicator
          {ω' : Ω | maxAbs (fun j => G i ω' j - muY j) >
            Real.sqrt (m : ℝ) / (4 * |d| * phi * Real.log (p : ℝ))}
          (fun ω' => (maxAbs (fun j => G i ω' j - muY j)) ^ 3) ω ∂P

/-- `M_m^*(φ) = M_m^Y(φ) + M_m^G(φ)`. -/
def Mstar {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) {p : ℕ} (m : ℕ) (d : ℝ)
    (muY : Fin p → ℝ) (Y : Fin m → Ω → Fin p → ℝ) (G : Fin m → Ω → Fin p → ℝ)
    (phi : ℝ) : ℝ :=
  MY P m d muY Y phi + MG P m d muY G phi

/-- At `δ_{n,m} = 0` the truncation level of `M_m^Y` is infinite and the
indicator is empty, so `M_m^Y(φ) = 0`. -/
@[simp] lemma MY_zero {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) {p m : ℕ}
    (muY : Fin p → ℝ) (Y : Fin m → Ω → Fin p → ℝ) (phi : ℝ) :
    MY P m 0 muY Y phi = 0 := by
  simp [MY]

/-- At `δ_{n,m} = 0` the truncation level of `M_m^G` is infinite and the
indicator is empty, so `M_m^G(φ) = 0`. -/
@[simp] lemma MG_zero {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) {p m : ℕ}
    (muY : Fin p → ℝ) (G : Fin m → Ω → Fin p → ℝ) (phi : ℝ) :
    MG P m 0 muY G phi = 0 := by
  simp [MG]

/-- At `δ_{n,m} = 0` the `m`-side truncated-moment quantity `M_m^*` vanishes. -/
@[simp] lemma Mstar_zero {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) {p m : ℕ}
    (muY : Fin p → ℝ) (Y : Fin m → Ω → Fin p → ℝ) (G : Fin m → Ω → Fin p → ℝ)
    (phi : ℝ) :
    Mstar P m 0 muY Y G phi = 0 := by
  simp [Mstar]

/-- At `δ_{n,m} = 0` every `m`-side contribution of the bound carries the
vanishing factor `|δ_{n,m}|^3 = 0`: the `m`-bracket drops out, so the source
conclusion at `δ ≡ 0` is the bounded-`n`/`m`/`p` inequality consisting of the
`n`-side terms plus `(min φ₁ φ₂)⁻¹ (log p)^{1/2}` (non-vacuity of that case). -/
lemma mSide_factor_zero (c r : ℝ) : c * |(0 : ℝ)| ^ 3 * r = 0 := by
  simp


/-- Covariance matrix `E[(X_i - μ^X)(X_i - μ^X)']` of the `i`-th `X`-vector. -/
def covX {Ω : Type*} [MeasurableSpace Ω] {p n : ℕ} (P : Measure Ω) (muX : Fin p → ℝ)
    (X : Fin n → Ω → Fin p → ℝ) (i : Fin n) : Matrix (Fin p) (Fin p) ℝ :=
  fun j k => ∫ ω, (X i ω j - muX j) * (X i ω k - muX k) ∂P

/-- Covariance matrix `E[(Y_i - μ^Y)(Y_i - μ^Y)']` of the `i`-th `Y`-vector. -/
def covY {Ω : Type*} [MeasurableSpace Ω] {p m : ℕ} (P : Measure Ω) (muY : Fin p → ℝ)
    (Y : Fin m → Ω → Fin p → ℝ) (i : Fin m) : Matrix (Fin p) (Fin p) ℝ :=
  fun j k => ∫ ω, (Y i ω j - muY j) * (Y i ω k - muY k) ∂P

/-- The four arrays collected on one index type, to express their joint
independence: `X^n`, `Y^m`, `F^n`, `G^m` are mutually independent. -/
def jointFam {Ω : Type*} {p n m : ℕ}
    (X : Fin n → Ω → Fin p → ℝ) (Y : Fin m → Ω → Fin p → ℝ)
    (F : Fin n → Ω → Fin p → ℝ) (G : Fin m → Ω → Fin p → ℝ) :
    (Fin n ⊕ (Fin m ⊕ (Fin n ⊕ Fin m))) → Ω → Fin p → ℝ
  | Sum.inl i => X i
  | Sum.inr (Sum.inl i) => Y i
  | Sum.inr (Sum.inr (Sum.inl i)) => F i
  | Sum.inr (Sum.inr (Sum.inr i)) => G i

end
