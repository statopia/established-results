/-- The max-coordinate statistic `max_j |z_j - c_j|`. -/
def maxCoord {p : ℕ} (z c : Fin p → ℝ) : ℝ :=
  ⨆ j : Fin p, |z j - c j|

/-- A hyperrectangle `{w | ∀ j, a_j ≤ w_j ≤ b_j}` in `ℝ^p` with extended-real
endpoints: finite, unbounded (`±∞`), and degenerate intervals are all allowed. -/
def hyperRect (p : ℕ) (lo hi : Fin p → EReal) : Set (Fin p → ℝ) :=
  {w | ∀ j : Fin p, lo j ≤ Real.toEReal (w j) ∧ Real.toEReal (w j) ≤ hi j}

/-- The class `𝒜^Re` of all hyperrectangles with `-∞ ≤ a_j ≤ b_j ≤ ∞`. -/
def ARe (p : ℕ) : Set (Set (Fin p → ℝ)) :=
  {A | ∃ lo hi : Fin p → EReal, (∀ j : Fin p, lo j ≤ hi j) ∧ A = hyperRect p lo hi}

/-- The normalized sum `S_n = n^{-1/2} ∑_{i=1}^n Z_i`, coordinatewise. -/
def normSum {Ω : Type*} {n p : ℕ} (Z : Fin n → Ω → (Fin p → ℝ)) (ω : Ω) : Fin p → ℝ :=
  fun j => (Real.sqrt (n : ℝ))⁻¹ * ∑ i : Fin n, Z i ω j

/-- `S_n^X - n^{1/2} μ^X + δ S_m^Y - δ m^{1/2} μ^Y` (the `X/Y` part of the mixture). -/
def partXY {Ω : Type*} {n m p : ℕ}
    (X : Fin n → Ω → (Fin p → ℝ)) (Y : Fin m → Ω → (Fin p → ℝ))
    (μX μY : Fin p → ℝ) (d : ℝ) (ω : Ω) : Fin p → ℝ :=
  fun j => normSum X ω j - Real.sqrt (n : ℝ) * μX j
            + d * normSum Y ω j - d * Real.sqrt (m : ℝ) * μY j

/-- `S_n^F - n^{1/2} μ^X + δ S_m^G - δ m^{1/2} μ^Y` (the `F/G` part of the mixture). -/
def partFG {Ω : Type*} {n m p : ℕ}
    (F : Fin n → Ω → (Fin p → ℝ)) (G : Fin m → Ω → (Fin p → ℝ))
    (μX μY : Fin p → ℝ) (d : ℝ) (ω : Ω) : Fin p → ℝ :=
  fun j => normSum F ω j - Real.sqrt (n : ℝ) * μX j
            + d * normSum G ω j - d * Real.sqrt (m : ℝ) * μY j

/-- `ρ*_{n,m}`: supremum over `v ∈ [0,1]` and hyperrectangles `A` of the absolute
difference between the mixture probability and the pure Gaussian probability. -/
def rhoStar {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) {n m p : ℕ}
    (X : Fin n → Ω → (Fin p → ℝ)) (Y : Fin m → Ω → (Fin p → ℝ))
    (F : Fin n → Ω → (Fin p → ℝ)) (G : Fin m → Ω → (Fin p → ℝ))
    (μX μY : Fin p → ℝ) (d : ℝ) : ℝ :=
  sSup ((fun v : ℝ =>
      sSup ((fun A : Set (Fin p → ℝ) =>
        |(μ {ω : Ω | (fun j : Fin p =>
              Real.sqrt v * partXY X Y μX μY d ω j
                + Real.sqrt (1 - v) * partFG F G μX μY d ω j) ∈ A}).toReal
          - (μ {ω : Ω | partFG F G μX μY d ω ∈ A}).toReal|) '' ARe p)) ''
    Set.Icc (0 : ℝ) 1)

/-- `L_n^X = max_j n^{-1} ∑_{i=1}^n E |Z_{ij} - c_j|^3`. -/
def Lstat {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) {n p : ℕ}
    (Z : Fin n → Ω → (Fin p → ℝ)) (c : Fin p → ℝ) : ℝ :=
  ⨆ j : Fin p, (n : ℝ)⁻¹ * ∑ i : Fin n, ∫ ω, |Z i ω j - c j| ^ 3 ∂μ

/-- Truncated third moment of `max_j |Z_j - c_j|` at truncation level `lev`. -/
def truncThird {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) {p : ℕ}
    (Z : Ω → (Fin p → ℝ)) (c : Fin p → ℝ) (lev : ℝ) : ℝ :=
  ∫ ω, if lev < maxCoord (Z ω) c then maxCoord (Z ω) c ^ 3 else 0 ∂μ

/-- Truncated `M`-functional
`Z^{-1} ∑_i E[max_j |Z_{ij} - c_j|^3 1{max_j |Z_{ij} - c_j| > lev}]`. -/
def Mstat {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) {n p : ℕ}
    (Z : Fin n → Ω → (Fin p → ℝ)) (c : Fin p → ℝ) (lev : ℝ) : ℝ :=
  (n : ℝ)⁻¹ * ∑ i : Fin n, truncThird μ (Z i) c lev

/-- `M_n(φ) = M_n^X(φ) + M_n^F(φ)`, truncation level `n^{1/2}/(4 φ log p)`. -/
def MstatN {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) {n p : ℕ}
    (X F : Fin n → Ω → (Fin p → ℝ)) (μX : Fin p → ℝ) (φ : ℝ) : ℝ :=
  Mstat μ X μX (Real.sqrt (n : ℝ) / (4 * φ * Real.log (p : ℝ)))
    + Mstat μ F μX (Real.sqrt (n : ℝ) / (4 * φ * Real.log (p : ℝ)))

/-- `M_m^*(φ) = M_m^Y(φ) + M_m^G(φ)`, truncation level
`m^{1/2}/(4 |δ| φ log p)`.  Formalization convention (source silent): `M_m^* = 0`
when `δ = 0`. -/
def MstatM {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) {m p : ℕ}
    (Y G : Fin m → Ω → (Fin p → ℝ)) (μY : Fin p → ℝ) (φ d : ℝ) : ℝ :=
  if d = 0 then 0
  else Mstat μ Y μY (Real.sqrt (m : ℝ) / (4 * |d| * φ * Real.log (p : ℝ)))
       + Mstat μ G μY (Real.sqrt (m : ℝ) / (4 * |d| * φ * Real.log (p : ℝ)))

/-- All `2n + 2m` random vectors of the four arrays, indexed jointly, so that
`iIndepFun` expresses the mutual independence of `X^n`, `Y^m`, `F^n`, `G^m`. -/
def allVec {Ω : Type*} {n m p : ℕ}
    (X : Fin n → Ω → (Fin p → ℝ)) (Y : Fin m → Ω → (Fin p → ℝ))
    (F : Fin n → Ω → (Fin p → ℝ)) (G : Fin m → Ω → (Fin p → ℝ)) :
    (Fin n ⊕ (Fin m ⊕ (Fin n ⊕ Fin m))) → Ω → (Fin p → ℝ) :=
  Sum.elim X (Sum.elim Y (Sum.elim F G))

