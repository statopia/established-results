/-- The row-max Euclidean norm `‖B‖_{2,∞} = max_j ‖B_{j,:}‖_2` on `p × q` real matrices:
the ordinary (unscaled) Euclidean `ℓ²` norm across the `q` columns, then the maximum over
the `p` rows. -/
noncomputable def rowMaxNorm {p q : ℕ} (B : Matrix (Fin p) (Fin q) ℝ) : ℝ :=
  ⨆ j : Fin p, Real.sqrt (∑ l : Fin q, (B j l) ^ 2)

/-- The `N × q` sample matrix whose `i`-th row is `H i ω`. -/
noncomputable def sampleMatH {Ω : Type*} {N q : ℕ} (H : Fin N → Ω → Fin q → ℝ) :
    Ω → Matrix (Fin N) (Fin q) ℝ :=
  fun ω i l => H i ω l

/-- The `N × p` sample matrix whose `i`-th row is `E i ω`. -/
noncomputable def sampleMatE {Ω : Type*} {N p : ℕ} (E : Fin N → Ω → Fin p → ℝ) :
    Ω → Matrix (Fin N) (Fin p) ℝ :=
  fun ω i j => E i ω j

/-- The `N × p` sample matrix whose `i`-th row is `f (H i ω)`, i.e. `f` applied rowwise to `H`. -/
noncomputable def sampleMatFH {Ω : Type*} {N p q : ℕ}
    (f : (Fin q → ℝ) → (Fin p → ℝ)) (H : Fin N → Ω → Fin q → ℝ) :
    Ω → Matrix (Fin N) (Fin p) ℝ :=
  fun ω i j => f (H i ω) j

/-- `M_f = 𝔼[f(H) Hᵀ]`, the `p × q` matrix with entries
`(M_f)_{j,l} = ∫ f(H)_j H_l`, the expectation being over the common joint law `ν` of a row
`(H, E)`.  By `𝔼[E Hᵀ] = 0` this also equals `𝔼[X Hᵀ]`. -/
noncomputable def Mf {p q : ℕ} (f : (Fin q → ℝ) → (Fin p → ℝ))
    (ν : Measure ((Fin q → ℝ) × (Fin p → ℝ))) : Matrix (Fin p) (Fin q) ℝ :=
  fun j l => ∫ z, f z.1 j * z.1 l ∂ν


/-- The simultaneous good event of the concentration lemma: both
`‖f(H)ᵀ H / N - M_f‖_{2,∞}` and `‖Eᵀ H / N‖_{2,∞}` are bounded by
`C_H √(q log p / N)`. -/
noncomputable def concEvent {Ω : Type*} {N p q : ℕ}
    (f : (Fin q → ℝ) → (Fin p → ℝ)) (E : Fin N → Ω → Fin p → ℝ)
    (H : Fin N → Ω → Fin q → ℝ) (Mfmat : Matrix (Fin p) (Fin q) ℝ) (C_H : ℝ) : Set Ω :=
  {ω | rowMaxNorm ((N : ℝ)⁻¹ • ((sampleMatFH f H ω)ᵀ * sampleMatH H ω) - Mfmat)
          ≤ C_H * Real.sqrt ((q : ℝ) * Real.log (p : ℝ) / (N : ℝ)) ∧
       rowMaxNorm ((N : ℝ)⁻¹ • ((sampleMatE E ω)ᵀ * sampleMatH H ω))
          ≤ C_H * Real.sqrt ((q : ℝ) * Real.log (p : ℝ) / (N : ℝ))}

/-- The simultaneous bad event of the concentration lemma: some entry of `f(H)ᵀ H / N - M_f` or of
`Eᵀ H / N` deviates from its mean by more than `C_H √(log p / N)` in absolute value.  Its complement
is contained in `concEvent`, since the Euclidean row norm of a row is at most `√q` times its largest
absolute entry. -/
noncomputable def badEvent {Ω : Type*} {N p q : ℕ}
    (f : (Fin q → ℝ) → (Fin p → ℝ)) (E : Fin N → Ω → Fin p → ℝ)
    (H : Fin N → Ω → Fin q → ℝ) (Mfmat : Matrix (Fin p) (Fin q) ℝ) (C_H : ℝ) : Set Ω :=
  {ω | ∃ (j : Fin p) (l : Fin q),
        C_H * Real.sqrt (Real.log (p : ℝ) / (N : ℝ)) <
          |((N : ℝ)⁻¹) * (∑ i : Fin N, f (H i ω) j * H i ω l) - Mfmat j l|} ∪
  {ω | ∃ (j : Fin p) (l : Fin q),
        C_H * Real.sqrt (Real.log (p : ℝ) / (N : ℝ)) <
          |((N : ℝ)⁻¹) * (∑ i : Fin N, E i ω j * H i ω l)|}


