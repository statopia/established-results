/-- The unit cube `[0,1]^d`. -/
def unitCube (d : ℕ) : Set (Fin d → ℝ) :=
  Set.Icc (fun _ => (0 : ℝ)) (fun _ => (1 : ℝ))

/-- The true `L²(P_X)` prediction error `∫ (f - f°)² dP_X` over the sample space
