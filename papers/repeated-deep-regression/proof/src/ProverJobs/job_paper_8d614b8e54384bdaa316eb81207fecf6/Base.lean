  ((n : ℝ) * (m : ℝ))⁻¹ * ∑ i : Fin n, ∑ j : Fin m, (f (X i j ω) - f0 (X i j ω)) ^ 2

/-- The localized class `𝓕(r) = {f ∈ 𝓕 : ∫ (f - f°)² dP_X ≤ r}`. -/
def localizedClass {α : Type*} [MeasurableSpace α] (F : Set (α → ℝ)) (PX : Measure α)
    (f0 : α → ℝ) (r : ℝ) : Set (α → ℝ) :=
  {f | f ∈ F ∧ predError PX f0 f ≤ r}

/-- `φ` is sub-root on `s`: `φ r / √r` is nonnegative and nonincreasing on `s`. -/
def IsSubRootOn (phi : ℝ → ℝ) (s : Set ℝ) : Prop :=
  (∀ r ∈ s, 0 ≤ phi r / Real.sqrt r) ∧ AntitoneOn (fun r => phi r / Real.sqrt r) s

/-- `φ` is sub-root: `φ r / √r` is nonnegative and nonincreasing on the positive radii. -/
def IsSubRoot (phi : ℝ → ℝ) : Prop := IsSubRootOn phi (Set.Ioi 0)

/-- The law of a Rademacher variable, uniform on `{-1, 1}`. -/
def rademacherLaw : Measure ℝ :=
  (2 : ℝ≥0∞)⁻¹ • (Measure.dirac (-1) + Measure.dirac 1)

/-- Supremum of the empirical Rademacher average over a finite subclass `𝓕* ⊆ 𝓕(r)`. -/
