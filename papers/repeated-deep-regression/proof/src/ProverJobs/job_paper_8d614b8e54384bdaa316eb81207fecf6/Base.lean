    (F : Set (α → ℝ)) (PX : Measure α)
    (f0 : α → ℝ) (X : Fin n → Fin m → Ωrand → α)
    (sigma : Fin n → Fin m → Ωrand → ℝ) (P : Measure Ωrand) (phi : ℝ → ℝ)
