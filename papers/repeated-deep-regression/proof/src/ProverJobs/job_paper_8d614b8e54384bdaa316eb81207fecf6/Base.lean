    (X : Fin n → Fin m → Ωrand → α) (ω : Ωrand) (f : α → ℝ) : ℝ :=
  ((n : ℝ) * (m : ℝ))⁻¹ * ∑ i : Fin n, ∑ j : Fin m, (Y i j ω - f (X i j ω)) ^ 2

/-- The empirical squared discrepancy `(nm)⁻¹ ∑_i ∑_j (f(X_ij) - f°(X_ij))²`. -/
def empSqDisc {α : Type*} {n m : ℕ} {Ωrand : Type*} (X : Fin n → Fin m → Ωrand → α)
