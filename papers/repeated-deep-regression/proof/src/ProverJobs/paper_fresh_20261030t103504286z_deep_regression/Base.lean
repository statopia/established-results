/-- The individual stochastic part `U_i(x) = Z_i(x) - f°(x)`. -/
def stochPart {ΩS Ω : Type*} {n : ℕ} (Z : Fin n → ΩS → Ω → ℝ) (fcirc : Ω → ℝ)
    (i : Fin n) (ω : ΩS) (x : Ω) : ℝ :=
  Z i ω x - fcirc x

/-- Repeated-measurement response `Y_ij = f°(X_ij) + U_i(X_ij) + ε_ij`. -/
def response {ΩS Ω : Type*} {n m : ℕ} (Z : Fin n → ΩS → Ω → ℝ)
    (eps : Fin n × Fin m → ΩS → ℝ) (X : Fin n × Fin m → ΩS → Ω) (fcirc : Ω → ℝ)
    (ij : Fin n × Fin m) (ω : ΩS) : ℝ :=
  fcirc (X ij ω) + stochPart Z fcirc ij.1 ω (X ij ω) + eps ij ω

/-- Pooled empirical risk `(1/(nm)) Σ_{i,j} (Y_ij - f(X_ij))²`. -/
def empRisk {ΩS Ω : Type*} {n m : ℕ} (X : Fin n × Fin m → ΩS → Ω)
    (Y : Fin n × Fin m → ΩS → ℝ) (f : Ω → ℝ) (ω : ΩS) : ℝ :=
  (1 / ((n : ℝ) * (m : ℝ))) * ∑ ij : Fin n × Fin m, (Y ij ω - f (X ij ω)) ^ 2

/-- The squared `L²(P_X)`-distance to `f°`, as an extended nonnegative integral. -/
def l2Err {Ω : Type*} [MeasurableSpace Ω] (PX : Measure Ω) (fcirc f : Ω → ℝ) : ℝ≥0∞ :=
  ∫⁻ x, ENNReal.ofReal ((f x - fcirc x) ^ 2) ∂PX

/-- The localized function class `F_nm(r) = {f ∈ F : ∫ (f - f°)² dP_X ≤ r}`. -/
def localized {Ω : Type*} [MeasurableSpace Ω] (PX : Measure Ω) (F : Set (Ω → ℝ))
    (fcirc : Ω → ℝ) (r : ℝ) : Set (Ω → ℝ) :=
  {f | f ∈ F ∧ l2Err PX fcirc f ≤ ENNReal.ofReal r}

/-- The Rademacher process `|(1/(nm)) Σ_{i,j} σ_ij (f - f°)(X_ij)|`. -/
def radProc {ΩS Ω : Type*} {n m : ℕ} (sig : Fin n × Fin m → ΩS → ℝ)
    (X : Fin n × Fin m → ΩS → Ω) (fcirc f : Ω → ℝ) (ω : ΩS) : ℝ≥0∞ :=
  ENNReal.ofReal
    |(1 / ((n : ℝ) * (m : ℝ))) *
      ∑ ij : Fin n × Fin m, sig ij ω * (f (X ij ω) - fcirc (X ij ω))|

/-- `E sup_{f ∈ F(r)} |...|` with the source's finite-subset convention: the supremum over
finite subsets is taken outside the expectation. -/
