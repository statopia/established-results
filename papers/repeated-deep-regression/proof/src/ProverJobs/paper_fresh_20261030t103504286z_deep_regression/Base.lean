/-- The mean squared prediction error `E_{f°}(fhat) = E[ ∫_Ω (fhat - f°)² dP_X ]`. -/
def predErr {ΩS Ω : Type*} [MeasurableSpace ΩS] [MeasurableSpace Ω] (mu : Measure ΩS)
    (PX : Measure Ω) (fcirc : Ω → ℝ) (fhat : ΩS → Ω → ℝ) : ℝ≥0∞ :=
  ∫⁻ ω, l2Err PX fcirc (fhat ω) ∂mu

/-- The approximation term `inf_{f ∈ F_nm} ∫_Ω (f - f°)² dP_X`. -/
def infRisk {Ω : Type*} [MeasurableSpace Ω] (PX : Measure Ω) (F : Set (Ω → ℝ))
    (fcirc : Ω → ℝ) : ℝ≥0∞ :=
  ⨅ (f : {f : Ω → ℝ // f ∈ F}), l2Err PX fcirc f.1

