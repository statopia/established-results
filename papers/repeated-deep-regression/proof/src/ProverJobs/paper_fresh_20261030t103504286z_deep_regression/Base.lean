    (mu : Measure ΩS) (PX : Measure Ω) (F : Set (Ω → ℝ)) (fcirc : Ω → ℝ)
    (sig : Fin n × Fin m → ΩS → ℝ) (X : Fin n × Fin m → ΩS → Ω) (r : ℝ) : ℝ≥0∞ :=
  ⨆ (s : Finset {f : Ω → ℝ // f ∈ localized PX F fcirc r}),
