/-! ## Notation layer for Theorem 4.1 (rank-`r` matrix recovery bound) -/

/-- `ψ_i(A)`: the ordered singular values `ψ_1(A) ≥ ⋯ ≥ ψ_n(A)` of an `m × n` matrix with
`n ≤ m`, indexed by `Fin n`. -/
noncomputable def psi {m n : ℕ} (hnm : n ≤ m) (A : Matrix (Fin m) (Fin n) ℝ) : Fin n → ℝ :=
  fun k => Statlib.HighDim.MatrixAnalysis.singularValues A (Fin.cast (Nat.min_eq_right hnm).symm k)

/-- Frobenius norm `‖A‖_F`. -/
noncomputable def frobNorm {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℝ) : ℝ :=
  Statlib.HighDim.MatrixAnalysis.frobeniusNorm A

/-- Spectral norm `‖A‖`: the largest singular value. -/
noncomputable def spectralNorm {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℝ) : ℝ :=
  if h : 0 < min m n then Statlib.HighDim.MatrixAnalysis.singularValues A ⟨0, h⟩ else 0

/-- Nuclear norm `‖A‖_*`: the sum of the singular values. -/
noncomputable def nuclearNorm {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℝ) : ℝ :=
  ∑ k : Fin (min m n), Statlib.HighDim.MatrixAnalysis.singularValues A k

/-- Maximum norm `‖A‖_∞`: the largest absolute value of an entry. -/
noncomputable def maxEntryNorm {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℝ) : ℝ :=
  sSup (Set.range (fun ij : Fin m × Fin n => |A ij.1 ij.2|))

/-- Squared `L2` norm of row `i`. -/
noncomputable def rowL2Sq {m k : ℕ} (U : Matrix (Fin m) (Fin k) ℝ) (i : Fin m) : ℝ :=
  ∑ j : Fin k, (U i j) ^ 2

/-- `‖U‖_{2,∞}^2`: the largest squared row `L2` norm. -/
noncomputable def twoInfNormSq {m k : ℕ} (U : Matrix (Fin m) (Fin k) ℝ) : ℝ :=
  sSup (Set.range (rowL2Sq U))

/-- `P_Ω(M)`: keeps the entries selected by `Ω` and sets the others to zero. -/
noncomputable def projMask {m n : ℕ} (Om : Matrix (Fin m) (Fin n) ℝ)
    (A : Matrix (Fin m) (Fin n) ℝ) : Matrix (Fin m) (Fin n) ℝ :=
  fun i j => Om i j * A i j

/-- The noisy matrix-completion observation `Y = P_Ω(M₀ + H)`. -/
noncomputable def obsMatrix {m n : ℕ} (Om M0 H : Matrix (Fin m) (Fin n) ℝ) :
    Matrix (Fin m) (Fin n) ℝ :=
  projMask Om (M0 + H)

/-- A sparse Gaussian reference matrix `P_Ω(G)/√m`. -/
noncomputable def refMatrix {m n : ℕ} (Om G : Matrix (Fin m) (Fin n) ℝ) :
    Matrix (Fin m) (Fin n) ℝ :=
  (Real.sqrt (m : ℝ))⁻¹ • projMask Om G

/-- Monte Carlo reference spectrum `λ̂_i = (1/T) ∑_t ψ_i(P_Ω(G_t)/√m)`. -/
noncomputable def lambdaHat {m n T : ℕ} (hnm : n ≤ m) (Om : Matrix (Fin m) (Fin n) ℝ)
    (G : Fin T → Matrix (Fin m) (Fin n) ℝ) : Fin n → ℝ :=
  fun i => (∑ t : Fin T, psi hnm (refMatrix Om (G t)) i) / (T : ℝ)

/-- The bulk index set `I = {⌈n/3⌉, …, ⌊2n/3⌋}` (one-indexed). -/
noncomputable def bulkIdx (n : ℕ) : Finset (Fin n) :=
  Finset.univ.filter (fun k : Fin n => (n + 2) / 3 ≤ k.1 + 1 ∧ k.1 + 1 ≤ 2 * n / 3)

/-- The working noise scale `σ̂(M)`. -/
noncomputable def sigmaHat {m n : ℕ} (hnm : n ≤ m) (lamHat : Fin n → ℝ)
    (Y Om M : Matrix (Fin m) (Fin n) ℝ) : ℝ :=
  (∑ k ∈ bulkIdx n, psi hnm (Y - projMask Om M) k) /
    (Real.sqrt (m : ℝ) * ∑ k ∈ bulkIdx n, lamHat k)

/-- The weighted spectrum criterion `l(N;ω) = ∑_i ω_i (ψ_i(N) - λ̂_i)^2`. -/
noncomputable def weightedLoss {m n : ℕ} (hnm : n ≤ m) (w lamHat : Fin n → ℝ)
    (N : Matrix (Fin m) (Fin n) ℝ) : ℝ :=
  ∑ i : Fin n, w i * (psi hnm N i - lamHat i) ^ 2

/-- The normalized loss `L(M) = p⁻¹ l((Y - P_Ω(M))/(√m σ̂(M)); ω)`; candidates with zero
bulk scale are assigned infinite loss. -/
noncomputable def normLoss {m n : ℕ} (hnm : n ≤ m) (p : ℝ) (w lamHat : Fin n → ℝ)
    (Y Om M : Matrix (Fin m) (Fin n) ℝ) : WithTop ℝ :=
  if sigmaHat hnm lamHat Y Om M = 0 then ⊤
  else
    (((p⁻¹ * weightedLoss hnm w lamHat
        (fun i j => (Y - projMask Om M) i j / (Real.sqrt (m : ℝ) * sigmaHat hnm lamHat Y Om M))) : ℝ)
      : WithTop ℝ)

/-- The candidate class `𝕄_{s,μ₁}`: rank at most `s` with `μ₁`-incoherent singular spaces
(leverage bounds on the left and right singular directions). -/
def CandidateClass {m n : ℕ} (s : ℕ) (mu1 : ℝ) (M : Matrix (Fin m) (Fin n) ℝ) : Prop :=
  Matrix.rank M ≤ s ∧
    ∃ (k : ℕ) (U : Matrix (Fin m) (Fin k) ℝ) (V : Matrix (Fin n) (Fin k) ℝ) (d : Fin k → ℝ),
      k ≤ s ∧ (∀ i, 0 < d i) ∧ Matrix.transpose U * U = 1 ∧ Matrix.transpose V * V = 1 ∧
        M = U * Matrix.diagonal d * Matrix.transpose V ∧
        (∀ i : Fin m, rowL2Sq U i ≤ mu1 * (s : ℝ) / (m : ℝ)) ∧
        (∀ j : Fin n, rowL2Sq V j ≤ mu1 * (s : ℝ) / (n : ℝ))

/-- The set `𝕄_{s,μ₁}` of admissible candidates. -/
def candidateSet {m n : ℕ} (s : ℕ) (mu1 : ℝ) : Set (Matrix (Fin m) (Fin n) ℝ) :=
  {M | CandidateClass s mu1 M}

/-- `a` is an argmin of `f` over `s`. -/
def IsArgminOn {α : Type*} {β : Type*} [Preorder β] (f : α → β) (s : Set α) (a : α) : Prop :=
  a ∈ s ∧ IsMinOn f s a

/-- The Bernoulli(`p`) law on `{0,1}`, viewed as a measure on `ℝ`. -/
noncomputable def bernoulliLaw (p : ℝ) : Measure ℝ :=
  ENNReal.ofReal p • Measure.dirac (1 : ℝ) + ENNReal.ofReal (1 - p) • Measure.dirac (0 : ℝ)


