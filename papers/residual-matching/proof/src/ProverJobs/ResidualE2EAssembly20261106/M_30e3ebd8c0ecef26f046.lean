/-- Unnormalized Frobenius norm `‖A‖_F = (∑_{ij} A_{ij}^2)^{1/2}`. -/
def frobNorm {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℝ) : ℝ :=
  Real.sqrt (∑ i : Fin m, ∑ j : Fin n, (A i j) ^ 2)

/-- Row `(2,∞)` norm: the largest `L₂` norm of the rows,
`‖A‖_{2,∞} = max_i (∑_j A_{ij}^2)^{1/2}`. -/
def rowNorm {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℝ) : ℝ :=
  ⨆ i : Fin m, Real.sqrt (∑ j : Fin n, (A i j) ^ 2)

/-- The unnormalized Frobenius / Hilbert–Schmidt inner product on real matrices. -/
def frobInner {m n : ℕ} (A B : Matrix (Fin m) (Fin n) ℝ) : ℝ :=
  ∑ i : Fin m, ∑ j : Fin n, A i j * B i j

/-- Spectral (operator) norm of a real matrix, i.e. the operator norm of the associated
continuous linear map between Euclidean spaces. -/
def specNorm {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℝ) : ℝ :=
  ‖(Matrix.toEuclideanLin ≪≫ₗ LinearMap.toContinuousLinearMap) A‖

/-- `b(A,C) = min{‖A‖_F ‖C‖_{2,∞}, ‖A‖_{2,∞} ‖C‖_F}` for matrices with the same row count. -/
def bFactor {d k l : ℕ} (A : Matrix (Fin d) (Fin k) ℝ) (C : Matrix (Fin d) (Fin l) ℝ) : ℝ :=
  min (frobNorm A * rowNorm C) (rowNorm A * frobNorm C)

/-- The centered Bernoulli matrix `W_Ω = p⁻¹ Ω − J`, in matrix coordinates. -/
def Wmask {m n : ℕ} (p : ℝ) (Om : Fin m → Fin n → ℝ) : Matrix (Fin m) (Fin n) ℝ :=
  fun i j => p⁻¹ * Om i j - 1

/-- `T_Ω = p⁻¹ P_Ω − Id`, in matrix-coordinate form: the Schur (entrywise) product with
`W_Ω`, i.e. `T_Ω A = W_Ω ⊙ A`. -/
def Tmask {m n : ℕ} (p : ℝ) (Om : Fin m → Fin n → ℝ)
    (A : Matrix (Fin m) (Fin n) ℝ) : Matrix (Fin m) (Fin n) ℝ :=
  fun i j => Wmask p Om i j * A i j

/-- The fixed tangent space at `M₀ = U₀ Σ₀ V₀ᵀ`:
`T_⋆ = {U₀ Aᵀ + B V₀ᵀ : A ∈ ℝ^{n×r}, B ∈ ℝ^{m×r}}` (note the shapes: `A` is `n × r` and
`B` is `m × r`). -/
def MemTangentRect {m n r : ℕ} (U0 : Matrix (Fin m) (Fin r) ℝ)
    (V0 : Matrix (Fin n) (Fin r) ℝ) (X : Matrix (Fin m) (Fin n) ℝ) : Prop :=
  ∃ A : Matrix (Fin n) (Fin r) ℝ, ∃ B : Matrix (Fin m) (Fin r) ℝ,
    X = U0 * A.transpose + B * V0.transpose

/-- The simultaneous good event of the mask-geometry lemma: the spectral-norm bound on
`W_Ω`, the `T_⋆`-tangent bound for `T_Ω`, and the two pointwise (deterministic)
consequences — the bilinear bound and the Schur-product bound. -/
def GoodEvent {m n r : ℕ} (p Lam th : ℝ) (Om : Matrix (Fin m) (Fin n) ℝ)
    (U0 : Matrix (Fin m) (Fin r) ℝ) (V0 : Matrix (Fin n) (Fin r) ℝ) : Prop :=
  specNorm (Wmask p Om) ≤ Lam ∧
  (∀ A B : Matrix (Fin m) (Fin n) ℝ,
      MemTangentRect U0 V0 A → MemTangentRect U0 V0 B →
      |frobInner (Tmask p Om A) B| ≤ th * frobNorm A * frobNorm B) ∧
  (∀ (k l : ℕ) (A : Matrix (Fin m) (Fin k) ℝ) (B : Matrix (Fin n) (Fin k) ℝ)
      (C : Matrix (Fin m) (Fin l) ℝ) (D : Matrix (Fin n) (Fin l) ℝ),
      |frobInner (Tmask p Om (A * B.transpose)) (C * D.transpose)|
        ≤ Lam * bFactor A C * bFactor B D) ∧
  (∀ (k : ℕ) (L : Matrix (Fin m) (Fin k) ℝ) (R : Matrix (Fin n) (Fin k) ℝ),
      specNorm (Tmask p Om (L * R.transpose))
        ≤ Lam * rowNorm L * rowNorm R)

end
