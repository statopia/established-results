/-! ## Norms and matrix objects of the source statement

`‖A‖` is the spectral norm (largest singular value), `‖A‖_F` the *unnormalised*
Frobenius norm, `‖A‖_{2,∞}` the largest Euclidean row norm. `P_Ω` is the entrywise
projection on the observed entries, `J` the all-ones matrix, `W_Ω = p⁻¹Ω - J` and
`T_Ω = p⁻¹P_Ω - Id`. -/

/-- Spectral norm `‖A‖`: the largest singular value (`ℓ² → ℓ²` operator norm). -/
def spectralNorm {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℝ) : ℝ :=
  Statlib.HighDim.MatrixAnalysis.opNorm A

/-- Squared unnormalised Frobenius norm `‖A‖_F ^ 2 = ∑_{ij} A_{ij}^2`. -/
def frobSq {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℝ) : ℝ :=
  ∑ i : Fin m, ∑ j : Fin n, A i j ^ 2

/-- Unnormalised Frobenius norm `‖A‖_F = (∑_{ij} A_{ij}^2)^{1/2}`. -/
def frob {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℝ) : ℝ := Real.sqrt (frobSq A)

/-- `‖A‖_{2,∞}`: the largest Euclidean row norm of `A` (not an operator norm). -/
def twoInfNorm {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℝ) : ℝ :=
  ⨆ i : Fin m, Real.sqrt (∑ j : Fin n, A i j ^ 2)

/-- The unnormalised trace/Frobenius pairing `⟨A,B⟩ = ∑_{ij} A_{ij} B_{ij}`. -/
def innerTrace {m n : ℕ} (A B : Matrix (Fin m) (Fin n) ℝ) : ℝ :=
  ∑ i : Fin m, ∑ j : Fin n, A i j * B i j

/-- `P_Ω`: entrywise projection keeping the observed entries and zeroing the others. -/
def projMask {m n : ℕ} (Om A : Matrix (Fin m) (Fin n) ℝ) : Matrix (Fin m) (Fin n) ℝ :=
  Matrix.of fun i j => Om i j * A i j

/-- The `m × n` all-ones matrix `J`. -/
def onesMat (m n : ℕ) : Matrix (Fin m) (Fin n) ℝ := Matrix.of fun _ _ => 1

/-- `W_Ω = p⁻¹ Ω - J`. -/
def Whats {m n : ℕ} (p : ℝ) (Om : Matrix (Fin m) (Fin n) ℝ) : Matrix (Fin m) (Fin n) ℝ :=
  p⁻¹ • Om - onesMat m n

/-- `T_Ω(A) = p⁻¹ P_Ω(A) - A`, the sampling-noise operator `p⁻¹P_Ω - Id` applied to `A`. -/
def TOm {m n : ℕ} (p : ℝ) (Om : Matrix (Fin m) (Fin n) ℝ) (A : Matrix (Fin m) (Fin n) ℝ) :
    Matrix (Fin m) (Fin n) ℝ :=
  p⁻¹ • projMask Om A - A

/-- `s₁`: the largest of the listed singular values (`⨆ i, sig i`; order-free). -/

def SMax {r : ℕ} (sig : Fin r → ℝ) : ℝ := ⨆ i, sig i

/-- `s_r`: the smallest of the `r` listed singular values (this is `s_⋆` for `M₀`). -/
def SMin {r : ℕ} (sig : Fin r → ℝ) : ℝ := ⨅ i, sig i

/-- `κ = s₁(M₀)/s_r(M₀)`. -/
def kappaOf {r : ℕ} (sig : Fin r → ℝ) : ℝ := SMax sig / SMin sig

/-- `\bar μ = max{μ₀, μ₁}`. -/
def barMuOf (mu0 mu1 : ℝ) : ℝ := max mu0 mu1

/-- `Λ = C √(m/p)`. -/
def LambdaOf (C : ℝ) (m : ℕ) (p : ℝ) : ℝ := C * Real.sqrt ((m : ℝ) / p)

/-- `θ = C √(μ₀ r log m / (n p))` (it uses `μ₀`, not `\bar μ`). -/
def thetaOf (C mu0 : ℝ) (r m n : ℕ) (p : ℝ) : ℝ :=
  C * Real.sqrt (mu0 * (r : ℝ) * Real.log (m : ℝ) / ((n : ℝ) * p))

/-- `a_g = C κ {θ + (1 + C_M) Λ \bar μ r / √(m n)}`. -/
def agOf (C kappa theta Lambda CM barMu : ℝ) (r m n : ℕ) : ℝ :=
  C * kappa * (theta + (1 + CM) * Lambda * (barMu * (r : ℝ)) / Real.sqrt ((m : ℝ) * (n : ℝ)))

/-- `a_g = C κ {θ + (1 + C_M) Λ \bar μ r / √(m n)}` for the data of the target statement.
The mask-geometry constants `Λ` and `θ` are explicit parameters (in the source they are the
constants of Lemma `lem:mask_geometry`, recorded as data, not the lemma's own witnesses). -/
def agMain (C mu0 mu1 : ℝ) {r : ℕ} (sig : Fin r → ℝ) (CM Lambda theta : ℝ) (m n : ℕ) : ℝ :=
  C * kappaOf sig *
    (theta + (1 + CM) * Lambda * barMuOf mu0 mu1 * (r : ℝ) / Real.sqrt ((m : ℝ) * (n : ℝ)))

/-- The displayed bound `C_{C_M} κ {√(\bar μ r log m/(np)) + \bar μ r/√(np)}` for `a_g`. -/
def agUpper (CCM mu0 mu1 : ℝ) {r : ℕ} (sig : Fin r → ℝ) (p : ℝ) (m n : ℕ) : ℝ :=
  CCM * kappaOf sig *
    (Real.sqrt (barMuOf mu0 mu1 * (r : ℝ) * Real.log (m : ℝ) / ((n : ℝ) * p)) +
      barMuOf mu0 mu1 * (r : ℝ) / Real.sqrt ((n : ℝ) * p))

/-- The sufficient condition `n p ≥ C_{C_M} κ² {\bar μ r log m + \bar μ² r²}`
(used only for the local restricted strong convexity clause). -/
def npCondition (CCM mu0 mu1 : ℝ) {r : ℕ} (sig : Fin r → ℝ) (p : ℝ) (m n : ℕ) : Prop :=
  CCM * kappaOf sig ^ 2 *
      (barMuOf mu0 mu1 * (r : ℝ) * Real.log (m : ℝ) + barMuOf mu0 mu1 ^ 2 * (r : ℝ) ^ 2)
    ≤ (n : ℝ) * p

/-- `b(A,C) = min{‖A‖_F ‖C‖_{2,∞}, ‖A‖_{2,∞} ‖C‖_F}`, the weight of R1's bilinear bound. -/
def bilinWeight {m n : ℕ} (A B : Matrix (Fin m) (Fin n) ℝ) : ℝ :=
  min (frob A * twoInfNorm B) (twoInfNorm A * frob B)

/-- `b(A,C) = min{‖A‖_F ‖C‖_{2,∞}, ‖A‖_{2,∞} ‖C‖_F}` evaluated on a *factor pair* of
matrices with the same number of rows but possibly different numbers of columns (the
source's weight in the bilinear mask bound, where the two factors may have different
numbers of columns). -/
def bFactor {m k l : ℕ} (A : Matrix (Fin m) (Fin k) ℝ) (C : Matrix (Fin m) (Fin l) ℝ) : ℝ :=
  min (frob A * twoInfNorm C) (twoInfNorm A * frob C)

/-- The incoherent class `𝕄_{r,μ₁}`: matrices of rank at most `r`, represented with
orthonormal factors `U`, `V` carrying the leverage (incoherence) bounds on their nonzero
singular directions; the zero matrix is included and has zero leverage. -/
def InLowRankClass {m n : ℕ} (r : ℕ) (mu1 : ℝ) (M : Matrix (Fin m) (Fin n) ℝ) : Prop :=
  M = 0 ∨
    ∃ (k : ℕ) (U : Matrix (Fin m) (Fin k) ℝ) (V : Matrix (Fin n) (Fin k) ℝ) (s : Fin k → ℝ),
      1 ≤ k ∧ k ≤ r ∧
      Matrix.transpose U * U = 1 ∧ Matrix.transpose V * V = 1 ∧
      M = U * Matrix.diagonal s * Matrix.transpose V ∧
      twoInfNorm U ^ 2 ≤ mu1 * (r : ℝ) / (m : ℝ) ∧
      twoInfNorm V ^ 2 ≤ mu1 * (r : ℝ) / (n : ℝ)

/-- The tangent space `T_⋆` at `M₀ = U₀ V₀'`: the space of matrices `U₀ A' + B V₀'`
(the source's definition; it is *not* the full matrix space, nor arbitrary). -/
def tangentSpace {m n r : ℕ} (U0 : Matrix (Fin m) (Fin r) ℝ) (V0 : Matrix (Fin n) (Fin r) ℝ) :
    Submodule ℝ (Matrix (Fin m) (Fin n) ℝ) :=
  Submodule.span ℝ {M : Matrix (Fin m) (Fin n) ℝ |
    ∃ (A : Matrix (Fin n) (Fin r) ℝ) (B : Matrix (Fin m) (Fin r) ℝ),
      M = U0 * Matrix.transpose A + B * Matrix.transpose V0}

/-- The event of Lemma `lem:mask_geometry` ("Uniform Bernoulli sampling bounds"): the
spectral bound `‖W_Ω‖ ≤ Λ`, the Schur bound `‖T_Ω(L R')‖ ≤ Λ ‖L‖_{2,∞}‖R‖_{2,∞}` (for
arbitrary conformable factors with a common, arbitrary number of columns, without summing
singular directions), the bilinear bound `|⟨T_Ω(AB'),CD'⟩| ≤ Λ b(A,C) b(B,D)` with the
*operator* constant `Λ` and the factor-pair weights
`b(A,C) = min{‖A‖_F‖C‖_{2,∞}, ‖A‖_{2,∞}‖C‖_F}` (the two factor pairs may have different
numbers of columns), and the tangent-form bound `|⟨A, T_Ω A⟩| ≤ θ ‖A‖_F²` on `T_⋆`
(with the constant `θ`). -/
def MaskEvent {m n : ℕ} (Lambda theta p : ℝ) (Om : Matrix (Fin m) (Fin n) ℝ)
    (Tstar : Submodule ℝ (Matrix (Fin m) (Fin n) ℝ)) : Prop :=
  spectralNorm (Whats p Om) ≤ Lambda ∧
  (∀ (k : ℕ) (L : Matrix (Fin m) (Fin k) ℝ) (R : Matrix (Fin n) (Fin k) ℝ),
      spectralNorm (TOm p Om (L * Matrix.transpose R))
        ≤ Lambda * twoInfNorm L * twoInfNorm R) ∧
  (∀ (k l : ℕ) (A1 : Matrix (Fin m) (Fin k) ℝ) (A2 : Matrix (Fin n) (Fin k) ℝ)
      (B1 : Matrix (Fin m) (Fin l) ℝ) (B2 : Matrix (Fin n) (Fin l) ℝ),
      |innerTrace (A1 * Matrix.transpose A2) (TOm p Om (B1 * Matrix.transpose B2))|
        ≤ Lambda * bFactor A1 B1 * bFactor A2 B2) ∧
  (∀ A ∈ Tstar, |innerTrace A (TOm p Om A)| ≤ theta * frob A ^ 2)

end
