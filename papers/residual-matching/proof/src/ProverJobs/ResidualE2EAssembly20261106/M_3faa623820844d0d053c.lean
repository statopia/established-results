/-! ## Matrix operations, singular values, masks, and Marchenko–Pastur quantiles -/

/-- `P_Ω(A)`: the entrywise mask operator, keeping the entries of `A` on the binary mask `Ω`
and setting all other entries to zero. -/
def maskOp {m n : ℕ} (Om A : Matrix (Fin m) (Fin n) ℝ) : Matrix (Fin m) (Fin n) ℝ :=
  fun i j => Om i j * A i j

/-- `sᵢ(A) = ψᵢ(A)`: the singular values of `A` in decreasing order, indexed by `Fin n`
(under the standing assumption `n ≤ m`, so that there are `n` of them). -/
def sv {m n : ℕ} (hnm : n ≤ m) (A : Matrix (Fin m) (Fin n) ℝ) (i : Fin n) : ℝ :=
  Statlib.HighDim.MatrixAnalysis.singularValues A (Fin.castLE (le_min hnm le_rfl) i)

/-- `‖A‖_{2,∞}`: the largest Euclidean (row `L²`) norm of the rows of `A`. -/
def rowSupNorm {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℝ) : ℝ :=
  ⨆ i : Fin m, Real.sqrt (∑ j : Fin n, A i j ^ 2)

/-- The all-ones matrix `J ∈ ℝ^{m×n}`. -/
def allOnesMat (m n : ℕ) : Matrix (Fin m) (Fin n) ℝ := fun _ _ => 1

/-- The centred mask operator `W_Ω = p⁻¹ P_Ω - J`, i.e. entrywise `p⁻¹ Ω_{ij} - 1`. -/
def centeredMaskOp {m n : ℕ} (p : ℝ) (Om : Matrix (Fin m) (Fin n) ℝ) :
    Matrix (Fin m) (Fin n) ℝ :=
  fun i j => p⁻¹ * Om i j - 1

/-- The tangent space `T_⋆` at `M₀ = U₀ D₀ V₀'`, encoded as
`(1 - U₀U₀') A (1 - V₀V₀') = 0` (equivalently `range A ⊆ range U₀` and
`range A' ⊆ range V₀`). -/
def inTangentSpace {m n r : ℕ} (U0 : Matrix (Fin m) (Fin r) ℝ) (V0 : Matrix (Fin n) (Fin r) ℝ)
    (A : Matrix (Fin m) (Fin n) ℝ) : Prop :=
  (1 - U0 * U0.transpose) * A * (1 - V0 * V0.transpose) = 0

/-- The orthogonal projection onto `T_⋆`:
`P_{T_⋆}(A) = A - (1 - U₀U₀') A (1 - V₀V₀')`, i.e. entrywise the same as
`U₀U₀'A + AV₀V₀' - U₀U₀'AV₀V₀'` on `T_⋆`. -/
def projTangent {m n r : ℕ} (U0 : Matrix (Fin m) (Fin r) ℝ) (V0 : Matrix (Fin n) (Fin r) ℝ)
    (A : Matrix (Fin m) (Fin n) ℝ) : Matrix (Fin m) (Fin n) ℝ :=
  A - (1 - U0 * U0.transpose) * A * (1 - V0 * V0.transpose)

/-- The projected mask operator `T_Ω = P_{T_⋆} ∘ P_Ω`. -/
def TOmega {m n r : ℕ} (Om : Matrix (Fin m) (Fin n) ℝ) (U0 : Matrix (Fin m) (Fin r) ℝ)
    (V0 : Matrix (Fin n) (Fin r) ℝ) (A : Matrix (Fin m) (Fin n) ℝ) :
    Matrix (Fin m) (Fin n) ℝ :=
  projTangent U0 V0 (maskOp Om A)

/-- The Frobenius (Hilbert–Schmidt) inner product
`⟨A,B⟩ = tr(A'B) = ∑_{i,j} A_{ij} B_{ij}`. -/
def matInner {m n : ℕ} (A B : Matrix (Fin m) (Fin n) ℝ) : ℝ :=
  ∑ i : Fin m, ∑ j : Fin n, A i j * B i j


/-- The aspect ratio `ρ = n/m`. -/
def rho (m n : ℕ) : ℝ := (n : ℝ) / (m : ℝ)

/-- `λ₊ = 1 + √ρ`. -/
def lambdaPlus (ρ : ℝ) : ℝ := 1 + Real.sqrt ρ

/-- `λ₋ = 1 - √ρ`. -/
def lambdaMinus (ρ : ℝ) : ℝ := 1 - Real.sqrt ρ

/-- The rooted Marchenko–Pastur density
`ν_ρ(x) = π⁻¹ √((λ₊² - x²)(x² - λ₋²)) / (ρ x)` supported on `[λ₋, λ₊]`. -/
def nuRho (ρ x : ℝ) : ℝ :=
  if lambdaMinus ρ ≤ x ∧ x ≤ lambdaPlus ρ then
    Real.sqrt ((lambdaPlus ρ ^ 2 - x ^ 2) * (x ^ 2 - lambdaMinus ρ ^ 2)) / (Real.pi * ρ * x)
  else 0

/-- `δ_m = (log m)⁻¹`. -/
def deltaM (m : ℕ) : ℝ := (Real.log (m : ℝ))⁻¹

/-- The middle-third index set `I = {⌈n/3⌉, …, ⌊2n/3⌋}`, expressed with `Fin n` indices. -/
def indexSet (n : ℕ) : Finset (Fin n) :=
  Finset.univ.filter fun i : Fin n => (n + 2) / 3 ≤ (i : ℕ) + 1 ∧ (i : ℕ) + 1 ≤ 2 * n / 3

/-- The homogeneous observation `Y = P_Ω(M₀ + H)`. -/
def Yobs {m n : ℕ} (Om M0 Hm : Matrix (Fin m) (Fin n) ℝ) : Matrix (Fin m) (Fin n) ℝ :=
  maskOp Om (M0 + Hm)

/-- The Monte-Carlo approximation `λ̂ᵢ = T⁻¹ ∑_t sᵢ(P_Ω(G^(t))/√m)`. -/
def lambdaHat {m n T : ℕ} (hnm : n ≤ m) (Om : Matrix (Fin m) (Fin n) ℝ)
    (G : Fin T → Matrix (Fin m) (Fin n) ℝ) (i : Fin n) : ℝ :=
  (T : ℝ)⁻¹ * ∑ t : Fin T, sv hnm (maskOp Om ((Real.sqrt (m : ℝ))⁻¹ • G t)) i

/-- The ideal same-mask reference `λᵢ^∘(Ω) = E_G[sᵢ(P_Ω(G)/√m) | Ω]`. -/
def lambdaCirc {m n : ℕ} (hnm : n ≤ m) (μG : Measure (Matrix (Fin m) (Fin n) ℝ))
    (Om : Matrix (Fin m) (Fin n) ℝ) (i : Fin n) : ℝ :=
  ∫ G, sv hnm (maskOp Om ((Real.sqrt (m : ℝ))⁻¹ • G)) i ∂μG

/-- The criterion `l(N;ω) = ∑ᵢ ωᵢ(ψᵢ(N) - λ̂ᵢ)²`. -/
def criterion {m n : ℕ} (hnm : n ≤ m) (w : Fin n → ℝ) (lamHat : Fin n → ℝ)
    (N : Matrix (Fin m) (Fin n) ℝ) : ℝ :=
  ∑ i : Fin n, w i * (sv hnm N i - lamHat i) ^ 2

/-- The working scale `σ̂(M) = (∑_{i∈I} ψᵢ(Y - P_Ω(M))) / (√m ∑_{i∈I} λ̂ᵢ)`. -/
def sigmaHat {m n : ℕ} (hnm : n ≤ m) (I : Finset (Fin n)) (lamHat : Fin n → ℝ)
    (Y Om M : Matrix (Fin m) (Fin n) ℝ) : ℝ :=
  (∑ i ∈ I, sv hnm (Y - maskOp Om M) i) / (Real.sqrt (m : ℝ) * ∑ i ∈ I, lamHat i)

/-- The normalized loss `ℒ(M;Y,Ω) = p⁻¹ l((Y - P_Ω(M))/(√m σ̂(M)); ω)`; candidates with zero
bulk scale `σ̂(M) = 0` are assigned infinite loss. -/
def loss {m n : ℕ} (hnm : n ≤ m) (I : Finset (Fin n)) (p : ℝ) (w : Fin n → ℝ)
    (lamHat : Fin n → ℝ) (Y Om M : Matrix (Fin m) (Fin n) ℝ) : ℝ≥0∞ :=
  if sigmaHat hnm I lamHat Y Om M = 0 then ⊤
  else
    ENNReal.ofReal (p⁻¹ * criterion hnm w lamHat
      ((Real.sqrt (m : ℝ) * sigmaHat hnm I lamHat Y Om M)⁻¹ • (Y - maskOp Om M)))

/-! ## Probability laws of the sampling objects -/

/-- A binary mask whose entries are independent `Bernoulli(p)` random variables. -/
def IsBernoulliMask {Ωs : Type*} [MeasurableSpace Ωs] {m n : ℕ} (μ : Measure Ωs)
    (Om : Ωs → Matrix (Fin m) (Fin n) ℝ) (p : ℝ) : Prop :=
  (∀ i j, Measurable fun s : Ωs => Om s i j) ∧
  (∀ s i j, Om s i j = 0 ∨ Om s i j = 1) ∧
  (∀ i j, μ {s | Om s i j = 1} = ENNReal.ofReal p) ∧
  iIndepFun (fun (x : Fin m × Fin n) => fun s : Ωs => Om s x.1 x.2) μ

/-- Indexing type for the joint entry family of `(Ω, H, G)`. -/
abbrev lawIndex (m n T : ℕ) : Type :=
  (Fin m × Fin n) ⊕ ((Fin m × Fin n) ⊕ (Fin T × Fin m × Fin n))

/-- The entry of `(Ω, H, G)` selected by an index of `lawIndex`. -/
def lawVar {m n T : ℕ} (Om Hm : Matrix (Fin m) (Fin n) ℝ)
    (G : Fin T → Matrix (Fin m) (Fin n) ℝ) (x : lawIndex m n T) : ℝ :=
  match x with
  | Sum.inl q => Om q.1 q.2
  | Sum.inr (Sum.inl q) => Hm q.1 q.2
  | Sum.inr (Sum.inr q) => G q.1 q.2.1 q.2.2

/-- The joint law of the sampling mask `Ω`, the noise `H` and the Monte-Carlo Gaussian
matrices `G^(t)`: all their entries are jointly independent, the mask entries are
`Bernoulli(p)`, the noise entries are centered with variance `σ²` and satisfy the uniform
sub-exponential tail bound `P(|H_{ij}| > tσ) ≤ 2 e^{-t/K}`, and the `G` entries are standard
Gaussian.  (`H/σ` therefore satisfies the independence, zero-mean, unit-variance and
sub-exponential tail assumptions of the cited sparse coarse rigidity lemma.) -/
def IsSamplingLaw {Ωs : Type*} [MeasurableSpace Ωs] {m n T : ℕ} (μ : Measure Ωs)
    (Om Hm : Ωs → Matrix (Fin m) (Fin n) ℝ) (G : Ωs → Fin T → Matrix (Fin m) (Fin n) ℝ)
    (p σ K : ℝ) : Prop :=
  (∀ i j, Measurable fun s : Ωs => Om s i j) ∧
  (∀ s i j, Om s i j = 0 ∨ Om s i j = 1) ∧
  (∀ i j, μ {s | Om s i j = 1} = ENNReal.ofReal p) ∧
  (∀ i j, Measurable fun s : Ωs => Hm s i j) ∧
  (∀ i j, Integrable (fun s : Ωs => Hm s i j) μ) ∧
  (∀ i j, ∫ s, Hm s i j ∂μ = 0) ∧
  (∀ i j, Integrable (fun s : Ωs => (Hm s i j) ^ 2) μ) ∧
  (∀ i j, ∫ s, (Hm s i j) ^ 2 ∂μ = σ ^ 2) ∧
  (∀ i j (t : ℝ), 0 < t →
    μ {s | t * σ < |Hm s i j|} ≤ ENNReal.ofReal (2 * Real.exp (-(t / K)))) ∧
  (∀ t i j, Measurable fun s : Ωs => G s t i j) ∧
  (∀ t i j, μ.map (fun s : Ωs => G s t i j) = gaussianReal 0 1) ∧
  iIndepFun (fun (x : lawIndex m n T) => fun s : Ωs => lawVar (Om s) (Hm s) (G s) x) μ

/-- The law of the Monte-Carlo Gaussian matrices alone. -/
def IsGaussianDrawsLaw {Ωs : Type*} [MeasurableSpace Ωs] {m n T : ℕ} (μ : Measure Ωs)
    (G : Ωs → Fin T → Matrix (Fin m) (Fin n) ℝ) : Prop :=
  (∀ t i j, Measurable fun s : Ωs => G s t i j) ∧
  (∀ t i j, μ.map (fun s : Ωs => G s t i j) = gaussianReal 0 1) ∧
  iIndepFun (fun (x : Fin T × Fin m × Fin n) => fun s : Ωs => G s x.1 x.2.1 x.2.2) μ

/-- A probability law on `m × n` matrices with i.i.d. standard Gaussian entries. -/
def IsStdGaussianMatrixLaw {m n : ℕ} (μG : Measure (Matrix (Fin m) (Fin n) ℝ)) : Prop :=
  (∀ i j, μG.map (fun A : Matrix (Fin m) (Fin n) ℝ => A i j) = gaussianReal 0 1) ∧
  iIndepFun (fun (x : Fin m × Fin n) => fun A : Matrix (Fin m) (Fin n) ℝ => A x.1 x.2) μG

/-- The fixed matrix `M₀` together with a compact SVD `M₀ = U₀ D₀ V₀'` with strictly positive
singular values (so `M₀` has rank exactly `r`), whose singular spaces are `μ₀`-incoherent:
`‖U₀‖_{2,∞} ≤ √(μ₀ r/m)` and `‖V₀‖_{2,∞} ≤ √(μ₀ r/n)`.
(No condition `12 r ≤ n` is imposed here, in accordance with the calibration lemma.) -/
def IsIncoherentSVD {m n r : ℕ} (M0 : Matrix (Fin m) (Fin n) ℝ)
    (U0 : Matrix (Fin m) (Fin r) ℝ) (d0 : Fin r → ℝ) (V0 : Matrix (Fin n) (Fin r) ℝ)
    (μ0 : ℝ) : Prop :=
  M0 = U0 * Matrix.diagonal d0 * V0.transpose ∧
  (∀ k, 0 < d0 k) ∧
  U0.transpose * U0 = 1 ∧
  V0.transpose * V0 = 1 ∧
  rowSupNorm U0 ≤ Real.sqrt (μ0 * (r : ℝ) / (m : ℝ)) ∧
  rowSupNorm V0 ≤ Real.sqrt (μ0 * (r : ℝ) / (n : ℝ))


