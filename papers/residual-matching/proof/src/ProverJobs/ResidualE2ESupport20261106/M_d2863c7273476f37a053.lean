/-! ## Rooted Marchenko–Pastur edges, density and deterministic quantiles -/

/-- Lower edge `λ₋ = 1 - √ρ` of the rooted Marchenko–Pastur law. -/
noncomputable def mpLambdaMinus (rho : ℝ) : ℝ := 1 - Real.sqrt rho

/-- Upper edge `λ₊ = 1 + √ρ` of the rooted Marchenko–Pastur law. -/
noncomputable def mpLambdaPlus (rho : ℝ) : ℝ := 1 + Real.sqrt rho

/-- The rooted Marchenko–Pastur density
`ν_ρ(x) = (1/π) √((λ₊² - x²)(x² - λ₋²)) / (ρ x)` on `[λ₋, λ₊]`, and `0` elsewhere. -/
noncomputable def rootedMPDensity (rho x : ℝ) : ℝ :=
  (1 / Real.pi) *
      Real.sqrt ((mpLambdaPlus rho ^ 2 - x ^ 2) * (x ^ 2 - mpLambdaMinus rho ^ 2)) /
        (rho * x) *
    (if mpLambdaMinus rho ≤ x ∧ x ≤ mpLambdaPlus rho then (1 : ℝ) else 0)

/-- The upper tail `t ↦ ∫_t^{λ₊} ν_ρ(x) dx` of the rooted Marchenko–Pastur density. -/
noncomputable def mpTail (rho : ℝ) (t : ℝ) : ℝ :=
  ∫ x in t..(mpLambdaPlus rho), rootedMPDensity rho x

/-- The deterministic rooted Marchenko–Pastur quantiles: for `1 ≤ i ≤ n`, `γ_i` is the
unique point with `∫_{γ_i}^{λ₊} ν_ρ = (i - 1/2)/n`. In `Fin`-indexing (`i.val + 1` plays the
role of `i`) the defining equation is `∫_{γ_i}^{λ₊} ν_ρ = (i.val + 1/2)/n`. These quantiles
depend only on `ρ` and `n`, never on the random data. -/
noncomputable def mpQuantile (rho : ℝ) (n : ℕ) (i : Fin n) : ℝ :=
  sSup {x : ℝ | (((i : ℕ) : ℝ) + 1 / 2) / (n : ℝ) ≤ mpTail rho x}

/-! ## Singular values and the masked, scaled observation matrix -/

/-- The singular values `s_1(A) ≥ ⋯ ≥ s_n(A)` of an `m × n` real matrix, indexed decreasingly
by `Fin n` (the source always has `m ≥ n`, so all `n` singular values are used). They are the
square roots of the decreasingly ordered eigenvalues of `Aᴴ A`; over `ℝ` the conjugate
transpose coincides with the transpose, so this is `√(eigenvalues of Aᵀ A)`. -/
noncomputable def svals {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℝ) : Fin n → ℝ :=
  fun i =>
    Real.sqrt
      ((Matrix.isHermitian_conjTranspose_mul_self A).eigenvalues₀
        (Fin.cast (Fintype.card_fin n).symm i))

/-- The entrywise mask operator and rescaling
`A = (mp)^{-1/2} P_Ω(Ξ)`, i.e. `A_{ij} = Ω_{ij} ξ_{ij} / √(mp)`, with `M` the `{0,1}`-valued
mask. -/
noncomputable def maskedScaled {m n : ℕ} (p : ℝ) (X M : Matrix (Fin m) (Fin n) ℝ) :
    Matrix (Fin m) (Fin n) ℝ :=
  fun i j => M i j * X i j / Real.sqrt ((m : ℝ) * p)

/-- The scale `δ_m = (log m)^{-1}`. -/
noncomputable def deltaM (m : ℕ) : ℝ := (Real.log (m : ℝ))⁻¹

/-- The maximal discrepancy `max_{1 ≤ i ≤ n} |s_i(A) - γ_i|`. -/
noncomputable def maxDeviation {n : ℕ} (s g : Fin n → ℝ) : ℝ :=
  sSup (Set.range fun i : Fin n => |s i - g i|)

